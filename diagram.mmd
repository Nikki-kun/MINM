classDiagram
    direction TB

    %% Enumerations
    class GroupType {
        <<enumeration>>
        DIALOG
        GROUP
        CHANNEL
    }

    class MessageStatus {
        <<enumeration>>
        SENT
        DELIVERED
        READ
    }

    class ParticipantStatus {
        <<enumeration>>
        ACTIVE
        INACTIVE
        BANNED
        PENDING
    }

    %% Core Entities
    class User {
        -UserID user_id
        -string username
        -string display_name
        -Timestamp registration_date
        -bool is_online
        +User(UserID, string, string)
        +getUserId() UserID
        +getUsername() string
        +getDisplayName() string
        +getRegistrationDate() Timestamp
        +getOnlineStatus() bool
        +setDisplayName(string) void
        +setOnlineStatus(bool) void
    }

    class Contact {
        -UserID owner_id
        -UserID contact_id
        -string alias
        -Timestamp added_date
        +Contact(UserID, UserID, string)
        +getOwnerId() UserID
        +getContactId() UserID
        +getAlias() string
        +getAddedDate() Timestamp
        +setAlias(string) void
    }

    class Message {
        -MessageID message_id
        -GroupID group_id
        -UserID author_id
        -string content
        -Timestamp timestamp
        -MessageStatus status
        -vector~string~ attachments
        +Message(MessageID, GroupID, UserID, string)
        +getMessageId() MessageID
        +getGroupId() GroupID
        +getAuthorId() UserID
        +getContent() string
        +getTimestamp() Timestamp
        +getStatus() MessageStatus
        +getAttachments() vector~string~
        +setStatus(MessageStatus) void
        +addAttachment(string) void
        +setContent(string) void
    }

    class Group {
        -GroupID group_id
        -GroupType type
        -string title
        -string description
        -vector~GroupParticipant~ participants
        -vector~Message~ messages
        -Timestamp created_date
        -UserID owner_id
        -int max_participants
        +Group(GroupID, GroupType, string, UserID)
        +addParticipant(UserID, UserID) bool
        +removeParticipant(UserID) bool
        +updateParticipantStatus(UserID, ParticipantStatus) bool
        +isUserInGroup(UserID) bool
        +addMessage(Message) void
        +getMessages() vector~Message~
        +getMessagesSince(Timestamp) vector~Message~
        +getParticipantIds() vector~UserID~
        +getParticipantCount() int
        +isFull() bool
        +getGroupId() GroupID
        +getType() GroupType
        +getTitle() string
        +getDescription() string
        +getCreatedDate() Timestamp
        +getOwnerId() UserID
        +getMaxParticipants() int
        +setTitle(string) void
        +setDescription(string) void
        +setMaxParticipants(int) void
    }

    %% GroupParticipant structure
    class GroupParticipant {
        <<struct>>
        -UserID user_id
        -ParticipantStatus status
        -Timestamp join_date
        -UserID added_by
        +GroupParticipant(UserID, UserID)
    }

    %% Managers
    class AuthManager {
        -unordered_map~string, AuthSession~ sessions
        -unordered_map~UserID, User~ users
        -unordered_map~string, UserID~ username_to_id
        -UserID next_user_id
        +AuthManager()
        +authenticate(string, UserID&) bool
        +createSession(UserID) string
        +invalidateSession(string) void
        +registerUser(string, string) User
        +getUser(UserID) User
        +getUserByUsername(string) User
        +userExists(string) bool
        +validateCredentials(string, string) bool
    }

    class ContactManager {
        -unordered_map~UserID, vector~Contact~~ user_contacts
        -unordered_map~UserID, vector~UserID~~ contact_requests
        +addContact(UserID, UserID, string) bool
        +removeContact(UserID, UserID) bool
        +updateContactAlias(UserID, UserID, string) bool
        +sendContactRequest(UserID, UserID) void
        +acceptContactRequest(UserID, UserID) bool
        +declineContactRequest(UserID, UserID) void
        +getContacts(UserID) vector~Contact~
        +getContactRequests(UserID) vector~UserID~
        +isContact(UserID, UserID) bool
    }

    class MessageManager {
        -unordered_map~MessageID, Message~ messages
        -unordered_map~GroupID, vector~MessageID~~ group_messages
        -unordered_map~MessageID, vector~UserID~~ message_read_by
        -MessageID next_message_id
        +MessageManager()
        +sendMessage(GroupID, UserID, string) Message
        +getMessage(MessageID) Message
        +getGroupMessages(GroupID) vector~Message~
        +getGroupMessagesSince(GroupID, Timestamp) vector~Message~
        +markMessageAsDelivered(MessageID) void
        +markMessageAsRead(MessageID, UserID) void
        +getMessageStatus(MessageID) MessageStatus
        +isMessageReadByUser(MessageID, UserID) bool
        +searchInGroup(GroupID, string) vector~Message~
    }

    class NotificationManager {
        -vector~NotificationCallback~ callbacks
        +notifyNewMessage(Message) void
        +notifyMessageStatusChanged(MessageID, MessageStatus) void
        +notifyGroupCreated(Group) void
        +notifyParticipantAdded(GroupID, UserID) void
        +notifyParticipantRemoved(GroupID, UserID) void
        +notifyParticipantStatusChanged(GroupID, UserID, ParticipantStatus) void
        +notifyUserStatusChanged(UserID, bool) void
        +subscribe(NotificationCallback) void
        +unsubscribe(NotificationCallback) void
    }

    %% AuthSession structure
    class AuthSession {
        <<struct>>
        -string token
        -UserID user_id
        -Timestamp created_at
        -Timestamp expires_at
    }

    %% Relationships
    User "1" --> "*" Contact : owns
    User "1" --> "*" Group : owns/participates
    Group "1" --> "*" GroupParticipant : contains
    Group "1" --> "*" Message : contains
    Message --> MessageStatus : has
    Group --> GroupType : has
    GroupParticipant --> ParticipantStatus : has
   
    AuthManager --> User : manages
    AuthManager --> AuthSession : manages
    ContactManager --> Contact : manages
    MessageManager --> Message : manages
   
    NotificationManager ..> Message : notifies about
    NotificationManager ..> Group : notifies about
    NotificationManager ..> User : notifies about
   
    Group --> MessageManager : uses
    Group --> AuthManager : uses
    ContactManager --> AuthManager : uses
   
    %% Dependency relationships
    MessageManager ..> Group : depends_on
    ContactManager ..> User : depends_on